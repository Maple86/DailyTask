page {
  background: #f4f5f7;
  color: #202124;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20, 40, 80, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.muted {
  color: #78808a;
  font-size: 24rpx;
}

.primary {
  color: #1677ff;
}

.success {
  color: #16a34a;
}

.danger {
  color: #dc2626;
}

.button-primary {
  margin-top: 24rpx;
  background: #1677ff;
  color: #fff;
}

.button-secondary {
  margin-top: 16rpx;
  background: #eef4ff;
  color: #1677ff;
}

.empty {
  padding: 80rpx 24rpx;
  color: #8c939d;
  text-align: center;
}
